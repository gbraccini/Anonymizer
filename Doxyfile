PROJECT_NAME           = "Anonymizer"
PROJECT_BRIEF          = "Oscuramento revisionabile di dati sensibili in immagini e PDF clinici"
OUTPUT_DIRECTORY       = build/doxygen
OUTPUT_LANGUAGE        = Italian
INPUT                  = src/anonymizer tools/packaging tools/experiments tools/deploy README.md docs
FILE_PATTERNS          = *.py *.js *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/*
USE_MDFILE_AS_MAINPAGE = README.md
OPTIMIZE_OUTPUT_JAVA   = YES
PYTHON_DOCSTRING       = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
SOURCE_BROWSER         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_LOGFILE           = build/doxygen/warnings.log
QUIET                  = YES
