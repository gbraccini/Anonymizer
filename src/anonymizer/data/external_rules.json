  "italian_address": {
    "street_types": [
      "via",
      "piazza",
      "corso",
      "viale",
      "vicolo",
      "largo",
      "piazzale",
      "lungomare"
    ],
    "context_words": [
      "indirizzo",
      "domicilio",
      "residente",
      "risiede",
      "abitazione"
    ],
    "postcode_context_words": [
      "CAP",
      "codice postale"
    ],
    "source": "openmed",
    "adaptation": "Reuse street types and context words; bounded component parser replaces greedy upstream address regex. Postcode requires explicit context or numbered street."
  },
  "original_openmed_patterns": {
    "street_address": {
      "pattern": "\\b(?:via|piazza|corso|viale|vicolo|largo|piazzale|lungomare)\\s+[A-Z\\u00c0-\\u00ff][a-z\\u00e0-\\u00ff]+(?:\\s+[A-Z\\u00c0-\\u00ff][a-z\\u00e0-\\u00ff]+)*(?:\\s*,?\\s*\\d{1,5})?\\b",
      "context_words": [
        "indirizzo",
        "domicilio",
        "residente",
        "risiede",
        "abitazione"
      ]
    },
    "postcode": {
      "pattern": "\\b\\d{5}\\b",
      "context_words": [
        "CAP",
        "codice postale"
      ]
    }
  },
  "clinical_rules": [
    {
      "id": "explicit_person_field_label",
      "pattern": "(?<![^\\r\\n])[ \\t]*(?P<value>(?i:paziente|nome[ \\t]+del[ \\t]+paziente|nominativo[ \\t]+del[ \\t]+paziente|cognome[ \\t]+(?:e[ \\t]+)?nome|nome[ \\t]+(?:e[ \\t]+)?cognome))(?=[ \\t]*[:=])",
      "value_group": "value",
      "ner_kinds": [
        "PERSON",
        "LOCATION",
        "FACILITY"
      ],
      "source": "medspacy",
      "adaptation_type": "local_logic_adaptation",
      "adaptation": "Local Italian postprocessing condition: explicit field label at line start, value never protected."
    },
    {
      "id": "explicit_clinician_field_label",
      "pattern": "(?<![^\\r\\n])[ \\t]*(?P<value>(?i:medico[ \\t]+(?:curante|refertante|richiedente|prescrittore|inviante|di[ \\t]+riferimento)|specialista[ \\t]+refertante|refertante|direttore[ \\t]+sanitario|radiologo))(?=[ \\t]*[:=])",
      "value_group": "value",
      "ner_kinds": [
        "PERSON",
        "LOCATION",
        "FACILITY"
      ],
      "source": "medspacy",
      "adaptation_type": "local_logic_adaptation",
      "adaptation": "Local Italian postprocessing condition: clinician role label, never the following name."
    },
    {
      "id": "document_noun_in_narrative",
      "pattern": "\\b(?i:lettura|interpretazione|copia|consultazione|valutazione|consegna)[ \\t]+(?i:del|dei|delle|della|dell\\x27|dell\\u2019)[ \\t]*(?P<value>(?i:referto|referti|analisi|risultati))(?![\\w\\u0300-\\u036f])",
      "value_group": "value",
      "ner_kinds": [
        "PERSON",
        "LOCATION",
        "FACILITY"
      ],
      "source": "medspacy",
      "adaptation_type": "local_logic_adaptation",
      "adaptation": "Local Italian modifier scope protects the document noun only; identifiers and following names remain eligible."
    }
  ],
  "policy": "Sources are pinned references, not runtime dependencies. Clinical guards suppress only fully contained L3 candidates, never L0-L2. EDS-PDF layout/medspaCy postprocessing are locally implemented concepts, not imported engines. No external network at runtime."
}
